{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Render throughput, per-phase latency, failure modes and resource headroom for the WoWS minimap render bot.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Renders (24h)",
      "description": "All render attempts across /render, /render_batch and /render_dual.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "sum(increase(wows_renders_total[24h]))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate (24h)",
      "description": "Share of attempts that produced a delivered video. `oversize` counts as a failure — the render worked but the user got nothing.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "sum(increase(wows_renders_total{outcome=\"success\"}[24h])) / clamp_min(sum(increase(wows_renders_total[24h])), 1)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In flight now",
      "description": "Renders currently occupying a pool worker. Sustained equality with MAX_WORKERS means the pool is the bottleneck.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "wows_renders_in_flight",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pool rebuilds (24h)",
      "description": "Times the ProcessPoolExecutor was rebuilt after a worker died. Non-zero usually means an OOM kill.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "sum(increase(wows_pool_rebuilds_total[24h]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Renders per hour by outcome",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "timeout" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "worker_crash" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "oversize" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          },
          {
            "matcher": { "id": "byName", "options": "upload_failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "sum by (outcome) (rate(wows_renders_total[$__rate_interval])) * 3600",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Phase latency p95",
      "description": "resolve = gamedata cache lookup (a slow one means a cache populate). upload = Discord transfer, absent for batch. Note: for the first few minutes after a deploy these quantiles read high — rate() extrapolates over a series younger than the rate window, which breaks bucket monotonicity. It self-corrects; do not chase it.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(wows_render_phase_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "End-to-end duration p50 / p95",
      "description": "Dispatch to delivered video, per command.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, command) (rate(wows_render_e2e_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{command}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, command) (rate(wows_render_e2e_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{command}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Encoding throughput (frames/sec)",
      "description": "Frames encoded divided by time spent in the render phase. A drop means renders got more expensive per frame.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "sum(rate(wows_render_frames_total[$__rate_interval])) / clamp_min(sum(rate(wows_render_phase_seconds_sum{phase=\"render\"}[$__rate_interval])), 0.001)",
          "legendFormat": "frames/sec"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Worker peak RSS p99 vs 4.5 GB cap",
      "description": "ru_maxrss is a per-process high-water mark that never resets, so with worker recycling disabled this covers the worker's whole lifetime, not one render.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "min": 0,
          "max": 4831838208,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3221225472 },
              { "color": "red", "value": 4831838208 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wows_render_worker_peak_rss_bytes_bucket[$__rate_interval])))",
          "legendFormat": "peak RSS p99"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Output size p50 / p99 vs 25 MB Discord limit",
      "description": "Crossing the limit produces an `oversize` outcome — the render succeeded but nothing was delivered.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" },
            "axisSoftMin": 0,
            "axisSoftMax": 27262976
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 26214400 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(wows_render_output_bytes_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wows_render_output_bytes_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Event loop lag p99",
      "description": "Delay beyond a 1s sleep. Sustained lag means something is blocking the asyncio loop that should be in the pool.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wows_bot_event_loop_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 lag"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Slowest layer init (p95, top 10)",
      "description": "Per-layer setup cost inside a render's setup phase.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, layer) (rate(wows_render_layer_init_seconds_bucket[$__rate_interval]))))",
          "legendFormat": "{{layer}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Queue wait + overhead (mean, derived)",
      "description": "Mean end-to-end minus mean sum-of-phases. What is left is time spent waiting for a free pool worker, downloading the attachment, and general overhead. This only holds because e2e is measured after the upload and therefore includes it, exactly as the phase sum does — if e2e is ever moved back before the upload this panel goes negative by the upload duration.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "(sum(rate(wows_render_e2e_seconds_sum[$__rate_interval])) - sum(rate(wows_render_phase_seconds_sum[$__rate_interval]))) / clamp_min(sum(rate(wows_render_e2e_seconds_count[$__rate_interval])), 0.0001)",
          "legendFormat": "queue wait + overhead"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Successful renders by game version",
      "description": "Kept off the histograms so their series count stays flat. A new version appearing here confirms the per-version gamedata cache resolved.",
      "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "wows-prometheus" },
          "expr": "sum by (game_version) (rate(wows_renders_by_version_total[$__rate_interval])) * 3600",
          "legendFormat": "v{{game_version}}"
        }
      ]
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wows", "renderer"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "WoWS Minimap Renderer",
  "uid": "wows-renderer",
  "version": 1,
  "weekStart": ""
}
